<!--
  Sigyn custom navigation behavior tree.

  Derived from nav2's navigate_to_pose_w_replanning_and_recovery.xml with two
  key changes to reduce time lost at narrow doorways:

  1. Recovery RoundRobin order changed to:
       BackUp  →  ClearBothCostmaps  →  Spin  →  Wait(1 s)

     The default order is ClearCostmaps → Spin → Wait(5 s) → BackUp.
    In practice the robot gets stuck just past a narrow doorway with its rear
    against a wall: even with limited reverse enabled in MPPI, the explicit
    recovery backup is the most reliable way to buy the forward clearance
    needed to re-enter the doorway cleanly. Putting it first saves ~20-25 s
    per doorway episode.

  2. Wait duration reduced 5.0 s → 1.0 s.
     The 5-second wait is cosmetically harmless in most scenarios but wastes
     time in this patrol context where the robot is typically physically blocked
     and a pause cannot help.
-->
<root BTCPP_format="4" main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <RecoveryNode number_of_retries="6" name="NavigateRecovery">
      <PipelineSequence name="NavigateWithReplanning">
        <ControllerSelector selected_controller="{selected_controller}" default_controller="FollowPath" topic_name="controller_selector"/>
        <PlannerSelector selected_planner="{selected_planner}" default_planner="GridBased" topic_name="planner_selector"/>
        <RateController hz="0.5">
          <!-- 0.5 Hz replanning: for short-range goals (< 1 m) replanning every
               second was generating ~25 path updates and causing MPPI to
               continuously re-aim, appearing as many small corrections.
               Every 2 s is sufficient for a home-environment patrol robot. -->
          <RecoveryNode number_of_retries="1" name="ComputePathToPose">
            <ComputePathToPose goal="{goal}" path="{path}" planner_id="{selected_planner}" error_code_id="{compute_path_error_code}"/>
            <Sequence>
              <WouldAPlannerRecoveryHelp error_code="{compute_path_error_code}"/>
              <ClearEntireCostmap name="ClearGlobalCostmap-Context" service_name="global_costmap/clear_entirely_global_costmap"/>
            </Sequence>
          </RecoveryNode>
        </RateController>
        <RecoveryNode number_of_retries="1" name="FollowPath">
          <FollowPath path="{path}" controller_id="{selected_controller}" error_code_id="{follow_path_error_code}"/>
          <Sequence>
            <WouldAControllerRecoveryHelp error_code="{follow_path_error_code}"/>
            <ClearEntireCostmap name="ClearLocalCostmap-Context" service_name="local_costmap/clear_entirely_local_costmap"/>
          </Sequence>
        </RecoveryNode>
      </PipelineSequence>
      <Sequence>
        <Fallback>
          <WouldAControllerRecoveryHelp error_code="{follow_path_error_code}"/>
          <WouldAPlannerRecoveryHelp error_code="{compute_path_error_code}"/>
        </Fallback>
        <ReactiveFallback name="RecoveryFallback">
          <GoalUpdated/>
          <RoundRobin name="RecoveryActions">
              <!-- BackUp FIRST: buys forward clearance when the rear is against a
                wall and the controller has painted itself into a tight local
                minimum at the doorway. -->
              <BackUp backup_dist="0.30" backup_speed="0.10" error_code_id="{backup_code_id}"/>
            <Sequence name="ClearingActions">
              <ClearEntireCostmap name="ClearLocalCostmap-Subtree" service_name="local_costmap/clear_entirely_local_costmap"/>
              <ClearEntireCostmap name="ClearGlobalCostmap-Subtree" service_name="global_costmap/clear_entirely_global_costmap"/>
            </Sequence>
            <Spin spin_dist="1.57" error_code_id="{spin_error_code}"/>
            <!-- Wait reduced 5.0 s → 1.0 s: pausing does not unblock physical
                 obstacles; a short wait only lets costmaps age out slightly. -->
            <Wait wait_duration="1.0"/>
          </RoundRobin>
        </ReactiveFallback>
      </Sequence>
    </RecoveryNode>
  </BehaviorTree>
</root>
